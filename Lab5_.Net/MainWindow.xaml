<Window x:Class="laba5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laba5"
        mc:Ignorable="d"
        Title="Список хворих відділення" Height="600" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Додати хворого" FontWeight="Bold"/>
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ПІБ:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="FullNameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Padding="2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Хвороба:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="DiseaseTextBox" Grid.Row="0" Grid.Column="3" Margin="5" Padding="2"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата надходження:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker x:Name="AdmissionDatePicker" Grid.Row="1" Grid.Column="1" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Робочий стаж (років):" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="WorkExperienceTextBox" Grid.Row="1" Grid.Column="3" Margin="5" Padding="2"/>
            </Grid>
            <Button x:Name="AddButton" Content="Додати хворого" Margin="5" Click="AddButton_Click"/>
        </StackPanel>
        <DataGrid x:Name="PatientsDataGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,10,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Хвороба" Binding="{Binding Disease}" Width="*"/>
                <DataGridTextColumn Header="Дата надходження" Binding="{Binding AdmissionDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding WorkExperience}" Width="Auto"/>
                <DataGridTextColumn Header="Днів на лікуванні" Binding="{Binding DaysInTreatment}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Лікуються більше (днів):" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="FilterDaysTextBox" Width="60" Margin="5" Padding="2" Text="7"/>
            <Button x:Name="FilterButton" Content="Фільтр" Margin="5" Click="FilterButton_Click"/>
            <Button x:Name="DeleteButton" Content="Видалити" Margin="5" Click="DeleteButton_Click"/>
            <Button x:Name="SortByNameButton" Content="Сортувати за ПІБ" Margin="5" Click="SortByNameButton_Click"/>
            <Button x:Name="LoadButton" Content="Завантажити" Margin="5" Click="LoadButton_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Margin="5" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
